{
  "name": "bigface-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Bigface — one dark palette, ported to the tools you use",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "themes": "bun run src/build.ts",
    "contrast": "bun run src/contrast.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test src site/src",
    "check": "bun run typecheck && bun run lint && bun test src site/src",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "site:preview": "bun run --cwd site preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/bun": "latest",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  }
}
