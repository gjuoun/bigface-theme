{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!themes",
      "!manifest.json",
      "!theme.css",
      "!site/public/themes",
      "!site/public/downloads",
      "!site/dist",
      "!site/.astro",
      "!src/fixtures",
      "!palette/*.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "none" } }
}
