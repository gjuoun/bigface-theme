{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!themes",
      "!site/public/themes",
      "!site/public/downloads",
      "!site/dist",
      "!site/.astro",
      "!src/fixtures",
      "!palette/*.json",
      "!packages/ui/src/components/ui",
      "!packages/ui/src/lib/utils.ts",
      "!packages/ui/src/lib/highlighter.tsx",
      "!packages/ui/src/hooks"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
