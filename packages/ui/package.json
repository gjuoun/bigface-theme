{
  "name": "@gjuoun/bigface-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bigface's component library: 63 shadcn primitives, the Bigface wrappers and palette-driven tokens.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./theme.css": "./src/styles/theme.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./src/styles/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ui:drift": "bun run scripts/ui-drift.ts",
    "theme:sync": "bun run scripts/gen-tokens.ts",
    "theme:check": "bun run scripts/gen-tokens.ts --check"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "shadcn": "^4.22.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "radix-ui": "^1.8.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.60.0",
    "cn": "^0.5.0",
    "cmdk": "^1.1.1",
    "vaul": "^1.1.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "date-fns": "^4.4.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "next-themes": "^0.4.6",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "radix-ui": "^1.8.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.60.0",
    "cn": "^0.5.0",
    "cmdk": "^1.1.1",
    "vaul": "^1.1.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "date-fns": "^4.4.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "next-themes": "^0.4.6",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1"
  }
}
