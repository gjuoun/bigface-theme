---
import { type Color, inkOn, sourceLabel } from "../data/palette.ts";

interface Props {
  name: string;
  color: Color;
}
const { name, color } = Astro.props;
// Whichever palette ink actually contrasts on this chip, and how much.
const { ink, ratio } = inkOn(color.hex);
---

<button
  type="button"
  class:list={["swatch", { derived: color.source === "derived" }]}
  data-copy={color.hex}
  data-swap="off"
  aria-label={`Copy ${name} ${color.hex}`}
>
  <span class="chip" style={`background:${color.hex};color:${ink}`}>
    <span class="hex">{color.hex}</span>
    <span class="ratio">{ratio}:1</span>
    <span class="copied">copy</span>
    {color.source === "derived" && <span class="flag">derived</span>}
  </span>
  <span class="meta">
    <strong>{name}</strong>
    <span class="src" class:list={{ derived: color.source === "derived" }}>{sourceLabel(color)}</span>
  </span>
</button>

<style>
  .swatch {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    text-align: left;
    font: inherit;
    color: inherit;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg-deep) 72.0%, transparent);
    cursor: pointer;
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s;
  }

  .swatch:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--blue) 40.0%, transparent);
    box-shadow: 0 22px 40px -30px color-mix(in srgb, var(--blue) 90.0%, transparent);
  }

  .chip {
    flex: 0 0 82px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 82px;
    padding: 0.5rem 0.65rem;
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .swatch.derived {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--orange) 55%, var(--border));
  }

  .chip .flag {
    position: absolute;
    top: 0.4rem;
    left: 0.5rem;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .chip {
    position: relative;
  }

  .chip .ratio {
    margin-left: auto;
    font-weight: 500;
    opacity: 0.78;
    letter-spacing: 0.02em;
  }

  .chip .copied {
    opacity: 0;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.6rem;
    transition: opacity 0.2s;
  }

  .swatch:hover .chip .copied {
    opacity: 0.7;
  }

  .meta {
    /* rows stretch to the tallest card; the footer takes the slack so no cell looks half-filled */
    flex: 1 1 auto;
    justify-content: center;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.65rem 0.6rem;
    font-size: 0.85rem;
  }

  .meta strong {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .src {
    color: var(--muted);
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.64rem;
    word-break: break-all;
    line-height: 1.4;
  }

  .src.derived {
    color: var(--orange);
  }
</style>
