---
import { type Color, sourceLabel } from "../data/palette.ts";

interface Props {
  name: string;
  color: Color;
}
const { name, color } = Astro.props;
const n = Number.parseInt(color.hex.slice(1), 16);
const lum = (0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255)) / 255;
const ink = lum > 0.55 ? "#111" : "#fff";
---
<div class="swatch">
  <div class="chip" style={`background:${color.hex};color:${ink}`}>{color.hex}</div>
  <div class="meta">
    <strong>{name}</strong>
    <span class="src" class:list={{ derived: color.source === "derived" }}>{sourceLabel(color)}</span>
  </div>
</div>

<style>
  .swatch { border: 1px solid var(--border-muted); border-radius: 8px; overflow: hidden; background: var(--bg-panel); }
  .chip { height: 64px; display: flex; align-items: flex-end; padding: .4rem .6rem; font: 600 .85rem ui-monospace, Menlo, monospace; }
  .meta { padding: .5rem .6rem; display: flex; flex-direction: column; gap: .1rem; font-size: .85rem; }
  .src { color: var(--dim); font-size: .7rem; word-break: break-all; }
  .src.derived { color: var(--orange); }
</style>
