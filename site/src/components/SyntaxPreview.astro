---
import { hex, palette, syntaxHex } from "../data/palette.ts";

interface Props {
  terminal?: boolean;
}
const { terminal = false } = Astro.props;

type Tok = [string, string?];
// A standard async entry point, so the window carries a real snippet instead of four loose lines.
const code: Tok[][] = [
  [["// main.ts — colours, not a screenshot.", "comment"]],
  [
    ["import", "keyword"],
    [" { ", "punctuation"],
    ["greet", "function"],
    [" } ", "punctuation"],
    ["from", "keyword"],
    [" "],
    ['"./hello"', "string"],
    [";", "punctuation"],
  ],
  [],
  [
    ["type", "keyword"],
    [" "],
    ["User", "type"],
    [" = ", "operator"],
    ["{ ", "punctuation"],
    ["id", "variable"],
    [": ", "punctuation"],
    ["number", "type"],
    ["; ", "punctuation"],
    ["name", "variable"],
    [": ", "punctuation"],
    ["string", "type"],
    [" };", "punctuation"],
  ],
  [],
  [
    ["const", "keyword"],
    [" "],
    ["ENDPOINT", "variable"],
    [" = ", "operator"],
    ['"https://api.example.com/users"', "string"],
    [";", "punctuation"],
  ],
  [],
  [
    ["export async function", "keyword"],
    [" "],
    ["main", "function"],
    ["(", "punctuation"],
    ["ids", "parameter"],
    [": ", "punctuation"],
    ["number", "type"],
    ["[]", "punctuation"],
    ["): ", "punctuation"],
    ["Promise", "type"],
    ["<", "operator"],
    ["void", "type"],
    [">", "operator"],
    [" {", "punctuation"],
  ],
  [
    ["  "],
    ["const", "keyword"],
    [" "],
    ["res", "variable"],
    [" = ", "operator"],
    ["await", "keyword"],
    [" "],
    ["fetch", "function"],
    ["(", "punctuation"],
    ["ENDPOINT", "variable"],
    [");", "punctuation"],
  ],
  [
    ["  "],
    ["if", "keyword"],
    [" (", "punctuation"],
    ["!", "operator"],
    ["res", "variable"],
    [".", "punctuation"],
    ["ok", "variable"],
    [") ", "punctuation"],
    ["throw", "keyword"],
    [" "],
    ["new", "keyword"],
    [" "],
    ["Error", "type"],
    ["(", "punctuation"],
    ["`users: ${res.status}`", "string"],
    [");", "punctuation"],
  ],
  [
    ["  "],
    ["const", "keyword"],
    [" "],
    ["all", "variable"],
    [": ", "punctuation"],
    ["User", "type"],
    ["[]", "punctuation"],
    [" = ", "operator"],
    ["await", "keyword"],
    [" "],
    ["res", "variable"],
    [".", "punctuation"],
    ["json", "function"],
    ["();", "punctuation"],
  ],
  [
    ["  "],
    ["const", "keyword"],
    [" "],
    ["picked", "variable"],
    [" = ", "operator"],
    ["all", "variable"],
    [".", "punctuation"],
    ["filter", "function"],
    ["((", "punctuation"],
    ["u", "parameter"],
    [") => ", "operator"],
    ["ids", "variable"],
    [".", "punctuation"],
    ["includes", "function"],
    ["(", "punctuation"],
    ["u", "variable"],
    [".", "punctuation"],
    ["id", "variable"],
    ["));", "punctuation"],
  ],
  [
    ["  "],
    ["picked", "variable"],
    [".", "punctuation"],
    ["forEach", "function"],
    ["((", "punctuation"],
    ["u", "parameter"],
    [") => ", "operator"],
    ["greet", "function"],
    ["(", "punctuation"],
    ["u", "variable"],
    [".", "punctuation"],
    ["name", "variable"],
    ["));", "punctuation"],
  ],
  [["}", "punctuation"]],
];
const colorOf = (role?: string) => (role ? syntaxHex(role) : hex("fg"));
const ansi = Object.entries(palette.ansi);

// Rendered as one HTML string per line: template whitespace would otherwise be preserved by
// `white-space: pre` and turn every source line into three line boxes.
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const render = (line: Tok[]): string =>
  line.length === 0
    ? " "
    : line
        .map(([text, role]) => `<span style="color:${colorOf(role)}">${esc(text)}</span>`)
        .join("");
---

<figure class="window">
  <div class="bar">
    <i /><i /><i />
    <span class="file">main.ts</span>
  </div>

  <pre class="code"><code>{code.map((line) => <span class="ln" set:html={render(line)} />)}</code></pre>

  {terminal && (
    <div class="term">
      <div class="prompt">
        <span style={`color:${hex("green")}`}>jun</span>
        <span style={`color:${hex("fgMuted")}`}> ~/code </span>
        <span style={`color:${hex("blue")}`}>❯</span>
        <span> git status</span>
        <span class="caret" style={`background:${hex("caret")}`} />
      </div>
      <div class="out">
        <span style={`color:${hex("green")}`}>On branch</span>
        <span style={`color:${hex("fg")}`}> main</span>
      </div>
      <div class="ansi">
        {ansi.map(([name, c]) => (
          <span style={`background:${c.hex}`} title={`${name} ${c.hex}`} />
        ))}
      </div>
    </div>
  )}
</figure>

<style>
  .window {
    margin: 0;
    background: var(--palette-deep);
    border: 1px solid rgba(var(--line-rgb), 0.22);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--caret) 6.0%, transparent), 0 30px 60px -40px #000;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--caret) 5.0%, transparent), transparent);
    border-bottom: 1px solid rgba(var(--line-rgb), 0.14);
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.72rem;
    color: #6e6b68;
  }

  .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .bar i:nth-child(1) {
    background: var(--pink);
  }

  .bar i:nth-child(2) {
    background: var(--yellow);
  }

  .bar i:nth-child(3) {
    background: var(--green);
  }

  .bar .file {
    margin-left: 0.55rem;
    color: var(--palette-fg);
    opacity: 0.6;
  }

  .code {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0.7rem 1rem 0.75rem;
    counter-reset: line;
    font-size: 0.79rem;
    line-height: 1.52;
  }

  .ln {
    display: block;
    white-space: pre;
  }

  .ln::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 1.6em;
    margin-right: 0.9em;
    text-align: right;
    color: var(--comment);
    user-select: none;
  }

  .term {
    border-top: 1px solid rgba(var(--line-rgb), 0.14);
    padding: 0.6rem 1rem 0.7rem;
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .prompt {
    display: flex;
    align-items: center;
    white-space: pre;
    color: var(--palette-fg);
  }

  .caret {
    display: inline-block;
    width: 7px;
    height: 1em;
    margin-left: 2px;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .out {
    white-space: pre;
  }

  .ansi {
    display: flex;
    height: 16px;
    margin-top: 0.6rem;
    border-radius: 4px;
    overflow: hidden;
  }

  .ansi span {
    flex: 1;
  }
</style>
