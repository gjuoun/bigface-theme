---
import { hex, palette, syntaxHex } from "../data/palette.ts";

interface Props {
  terminal?: boolean;
}
const { terminal = false } = Astro.props;

type Tok = [string, string?];
const code: Tok[][] = [
  [["// Greets someone, then counts.", "comment"]],
  [
    ["import", "keyword"],
    [" { ", "punctuation"],
    ["greet", "function"],
    [" } ", "punctuation"],
    ["from", "keyword"],
    [" "],
    ['"./hello"', "string"],
    [";", "punctuation"],
  ],
  [],
  [
    ["const", "keyword"],
    [" "],
    ["answer", "variable"],
    [": ", "punctuation"],
    ["number", "type"],
    [" "],
    ["=", "operator"],
    [" "],
    ["42", "number"],
    [";", "punctuation"],
  ],
  [],
  [
    ["export function", "keyword"],
    [" "],
    ["main", "function"],
    ["(", "punctuation"],
    ["name", "parameter"],
    [": ", "punctuation"],
    ["string", "type"],
    [") {", "punctuation"],
  ],
  [
    ["  "],
    ["const", "keyword"],
    [" "],
    ["msg", "variable"],
    [" "],
    ["=", "operator"],
    [" "],
    ["`Hello, ${name}`", "string"],
    [";", "punctuation"],
  ],
  [
    ["  "],
    ["return", "keyword"],
    [" "],
    ["greet", "function"],
    ["(", "punctuation"],
    ["msg", "variable"],
    [", ", "punctuation"],
    ["answer", "variable"],
    [");", "punctuation"],
  ],
  [["}", "punctuation"]],
];
const colorOf = (role?: string) => (role ? syntaxHex(role) : hex("fg"));
const ansi = Object.entries(palette.ansi);
---

<figure class="window">
  <div class="bar">
    <i /><i /><i />
    <span class="file">main.ts</span>
  </div>

  <pre class="code"><code>{code.map((line) => (
    <span class="ln">
      {line.length === 0
        ? " "
        : line.map(([text, role]) => <span style={`color:${colorOf(role)}`}>{text}</span>)}
    </span>
  ))}</code></pre>

  {terminal && (
    <div class="term">
      <div class="prompt">
        <span style={`color:${hex("green")}`}>jun</span>
        <span style={`color:${hex("fgMuted")}`}> ~/code </span>
        <span style={`color:${hex("blue")}`}>❯</span>
        <span> git status</span>
        <span class="caret" style={`background:${hex("caret")}`} />
      </div>
      <div class="out">
        <span style={`color:${hex("green")}`}>On branch</span>
        <span style={`color:${hex("fg")}`}> main</span>
      </div>
      <div class="out">
        <span style={`color:${hex("comment")}`}>nothing to commit, working tree clean</span>
      </div>
      <div class="ansi">
        {ansi.map(([name, c]) => (
          <span style={`background:${c.hex}`} title={`${name} ${c.hex}`} />
        ))}
      </div>
    </div>
  )}
</figure>

<style>
  .window {
    margin: 0;
    background: var(--palette-deep);
    border: 1px solid rgba(126, 176, 240, 0.22);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 30px 60px -40px #000;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.05), transparent);
    border-bottom: 1px solid rgba(126, 176, 240, 0.14);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #6e6b68;
  }

  .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .bar i:nth-child(1) {
    background: var(--pink);
  }

  .bar i:nth-child(2) {
    background: var(--yellow);
  }

  .bar i:nth-child(3) {
    background: var(--green);
  }

  .bar .file {
    margin-left: 0.55rem;
    color: var(--palette-fg);
    opacity: 0.6;
  }

  .bar .badge {
    margin-left: auto;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid rgba(126, 176, 240, 0.25);
    color: var(--blue);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .code {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0.85rem 1rem;
    counter-reset: line;
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .ln {
    display: block;
    white-space: pre;
  }

  .ln::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 1.6em;
    margin-right: 0.9em;
    text-align: right;
    color: #4a4a45;
    user-select: none;
  }

  .term {
    border-top: 1px solid rgba(126, 176, 240, 0.14);
    padding: 0.8rem 1rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .prompt {
    display: flex;
    align-items: center;
    white-space: pre;
    color: var(--palette-fg);
  }

  .caret {
    display: inline-block;
    width: 7px;
    height: 1em;
    margin-left: 2px;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .out {
    white-space: pre;
  }

  .ansi {
    display: flex;
    height: 16px;
    margin-top: 0.6rem;
    border-radius: 4px;
    overflow: hidden;
  }

  .ansi span {
    flex: 1;
  }
</style>
