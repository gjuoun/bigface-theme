---
import { contrastReport } from "../data/contrast.ts";
import { palette } from "../data/palette.ts";

const rows = contrastReport(palette as never);
const label = (r: number) => (r >= 7 ? "AAA" : r >= 4.5 ? "AA" : r >= 3 ? "large text" : "below 3");
---
<table>
  <thead><tr><th>Colour</th><th>Hex</th><th>Ratio on background</th><th>WCAG</th></tr></thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td><i style={`background:${r.hex}`} /> {r.name}</td>
        <td><code>{r.hex}</code></td>
        <td>{r.ratio.toFixed(1)} : 1</td>
        <td class:list={{ low: r.ratio < 4.5 }}>{label(r.ratio)}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid var(--border-muted); }
  th { color: var(--fg-muted); font-weight: 600; }
  i { display: inline-block; width: .8em; height: .8em; border-radius: 3px; vertical-align: -.05em; }
  .low { color: var(--orange); }
</style>
