---
import InstallSteps from "../../components/InstallSteps.astro";
import SyntaxPreview from "../../components/SyntaxPreview.astro";
import { installCommand, REPO, rawUrl, type Target, targets } from "../../data/targets.ts";
import { themeFile } from "../../data/themes.ts";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return targets.map((t) => ({ params: { id: t.id }, props: { target: t } }));
}
const { target } = Astro.props as { target: Target };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const main = target.files[0]!;
const source = themeFile(target.id, main.path);
const shown = source.split("\n").slice(0, 40).join("\n");
const truncated = source.split("\n").length > 40;
const install = installCommand(target.id);
const uninstall = installCommand(`--uninstall ${target.id}`);
const levelLabel = {
  tool: "Checked with the tool",
  schema: "Checked against its schema",
  format: "Format-checked only",
}[target.check.level];
const index = targets.findIndex((t) => t.id === target.id);
const next = targets[(index + 1) % targets.length]!;
---

<Base title={`Bigface for ${target.name}`} description={`${target.name}: ${target.tagline}`}>
  <nav class="crumbs dim" aria-label="Breadcrumb">
    <a href={`${base}/`}>Bigface</a>
    <span>/</span>
    <a href={`${base}/#apps`}>Apps</a>
    <span>/</span>
    <span class="here">{target.name}</span>
  </nav>

  <header class="app-hero" data-reveal>
    <div>
      <p class="eyebrow">{target.kind} · port {String(index + 1).padStart(2, "0")} of {targets.length}</p>
      <h1><span class="grad">Bigface for {target.name}</span></h1>
      <p class="lead">{target.tagline}</p>
      <div class="meta">
        <span class={`pill ${target.check.level}`}>{levelLabel}</span>
        <span class="pill">{target.files.length} file{target.files.length === 1 ? "" : "s"}</span>
      </div>
    </div>
  </header>

  <section class="preview" data-reveal>
    {target.screenshot ? (
      <figure class="shot">
        <img
          src={`${base}/${target.screenshot.file}`}
          alt={target.screenshot.alt}
          width={target.screenshot.width}
          height={target.screenshot.height}
          loading="lazy"
        />
        <figcaption class="dim">
          A real screenshot: Obsidian 1.14.4, reading view, Bigface theme.
        </figcaption>
      </figure>
    ) : (
      <SyntaxPreview terminal={target.terminalPreview} />
    )}
  </section>

  <section id="install" data-reveal>
    <h2>Install</h2>
    <div class="card glow terminal-card">
      <div class="tabs" data-tabs role="tablist" aria-label="Install options">
        <button type="button" role="tab" data-tab aria-selected="true" aria-controls={`tab-${target.id}`}>
          Install
        </button>
        <button type="button" role="tab" data-tab aria-selected="false" aria-controls={`tab-off-${target.id}`}>
          Uninstall
        </button>
      </div>

      <div id={`tab-${target.id}`} class="panel" role="tabpanel">
        <pre class="cmd"><code>{install}</code></pre>
        <div class="panel-foot">
          <span class="dim">Writes Bigface's own file, prints the one line to add.</span>
          <button class="copy" type="button" data-copy={install} data-swap="off">copy</button>
        </div>
      </div>

      <div id={`tab-off-${target.id}`} class="panel" role="tabpanel" hidden>
        <pre class="cmd"><code>{uninstall}</code></pre>
        <div class="panel-foot">
          <span class="dim">Removes the file and prints the line to drop.</span>
          <button class="copy" type="button" data-copy={uninstall} data-swap="off">copy</button>
        </div>
      </div>
    </div>
    <p class="dim">
      It never edits your config; it prints the one line you still need to add (or remove).
      <a href={`${base}/install.sh`}>Read the script</a> first, or add <code>--dry-run</code>.
    </p>

    <details>
      <summary>Or do it by hand</summary>
      <InstallSteps steps={target.steps} />
    </details>
  </section>

  <section data-reveal>
    <h2>Download</h2>
    <ul class="downloads">
      {target.download && (
        <li>
          <a class="dl card" href={`${base}/${target.download.href}`} download>
            <span class="dl-icon">↓</span>
            <span>
              <strong>{target.download.label}</strong>
              <span class="dim">packaged extension</span>
            </span>
          </a>
        </li>
      )}
      {target.files.map((f) => (
        <li class="dl-row">
          <a class="dl card" href={`${base}/themes/${target.id}/${f.path}`} download>
            <span class="dl-icon">↓</span>
            <span>
              <strong>{f.label}</strong>
              <span class="dim">download the file</span>
            </span>
          </a>
          <a class="raw" href={rawUrl(target.id, f.path)}>raw on GitHub</a>
        </li>
      ))}
    </ul>
  </section>

  <section data-reveal>
    <h2>What was checked</h2>
    <p class="checkline">
      <span class={`pill ${target.check.level}`}>{levelLabel}</span>
      <span class="muted">{target.check.text}</span>
    </p>
  </section>

  <section data-reveal>
    <h2>{main.label}</h2>
    <div class="code-card card">
      <div class="code-bar">
        <span class="dim">themes/{target.id}/{main.path}</span>
        <button class="copy" type="button" data-copy={shown} data-swap="off">copy</button>
      </div>
      <pre><code>{shown}{truncated ? "\n…" : ""}</code></pre>
    </div>
    <p class="dim">
      Generated from the <a href={`${base}/palette/`}>palette</a>. Source:
      <a href={`${REPO}/tree/main/themes/${target.id}`}>themes/{target.id}</a>.
    </p>
  </section>

  <a class="next card" href={`${base}/apps/${next.id}/`}>
    <span class="dim">Next up</span>
    <strong>Bigface for {next.name}</strong>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    padding-top: 0.5rem;
  }

  .crumbs .here {
    color: var(--fg);
  }

  .app-hero {
    padding: 1.5rem 0 0.5rem;
  }

  .app-hero h1 {
    font-size: clamp(2.3rem, 5.2vw, 3.6rem);
    font-weight: 800;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .preview {
    margin: 1.8rem 0 0;
  }

  .shot {
    margin: 0;
  }

  .shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 14px;
    display: block;
  }

  .shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
  }

  .terminal-card {
    padding: 0.9rem;
    margin-top: 0.6rem;
  }

  .panel {
    margin-top: 0.8rem;
  }

  .panel pre {
    margin: 0;
    background: rgba(2, 7, 15, 0.85);
  }

  .panel-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.3rem 0.1rem;
    font-size: 0.8rem;
  }

  .downloads {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 560px;
  }

  .dl {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border-radius: 14px;
    color: var(--fg);
    transition: border-color 0.25s, transform 0.25s var(--ease);
  }

  .dl:hover {
    border-color: rgba(0, 176, 255, 0.45);
    transform: translateY(-2px);
    color: var(--fg);
  }

  .dl-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(0, 176, 255, 0.14);
    color: var(--blue);
    font-size: 0.95rem;
  }

  .dl strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .dl-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .dl-row .dl {
    flex: 1;
  }

  .dl .dim,
  .raw {
    font-size: 0.75rem;
  }

  .raw {
    color: var(--dim);
    white-space: nowrap;
  }

  .raw:hover {
    color: var(--blue);
  }

  .checkline {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
    max-width: 68ch;
  }

  .code-card {
    padding: 0.4rem;
    overflow: hidden;
  }

  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.5rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .code-card pre {
    margin: 0;
    max-height: 420px;
    overflow: auto;
    background: rgba(2, 7, 15, 0.85);
  }

  details {
    margin: 1.2rem 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(9, 22, 42, 0.55);
  }

  summary {
    cursor: pointer;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .next {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 3rem;
    padding: 1rem 1.2rem;
    border-radius: 16px;
    color: var(--fg);
    font-family: var(--font-display);
  }

  .next .dim {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .next .arrow {
    margin-left: auto;
    color: var(--blue);
  }

  .next:hover {
    border-color: rgba(0, 176, 255, 0.45);
    color: var(--fg);
  }
</style>
