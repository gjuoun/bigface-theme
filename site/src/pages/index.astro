---
import SyntaxPreview from "../components/SyntaxPreview.astro";
import { inline } from "../data/inline.ts";
import { hex, inkOn, palette } from "../data/palette.ts";
import { installCommand, REPO, targets } from "../data/targets.ts";
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const strip = ["blue", "cyan", "lime", "green", "yellow", "burntOrange", "brightYellow", "purple"];
const kinds = [...new Set(targets.map((t) => t.kind))];
const marquee = [
  ...targets.map((t) => t.name),
  "one palette",
  `${targets.length} ports`,
  "since 2018",
];
const colourCount = Object.keys(palette.colors).length;
const quick = installCommand();
const levelLabel = {
  tool: "Checked with the tool",
  schema: "Checked against its schema",
  format: "Format-checked only",
};
const isLevel = (level: string): level is keyof typeof levelLabel => level in levelLabel;
const oneApp = installCommand("ghostty zed vim");
const everything = installCommand("all");
const removeAll = installCommand("--uninstall all");
---

<Base title="Bigface — a dark color theme for your tools">
  <section class="hero">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">one palette · {targets.length} ports · since 2018</p>
      <h1><span class="grad">Bigface</span></h1>
      <p class="lead">
        One dark palette, ported to {targets.length} tools. No per-tool tweaking, no variants, no
        second-guessing.
      </p>
      <p class="muted">
        Born in 2018 as a JetBrains scheme, now generated for your terminal, editors, shell and notes
        from a single palette file. Every colour that came from the original scheme is checked
        against it by a test.
      </p>
      <div class="actions">
        <a class="btn" href="#install">Install in one line</a>
        <a class="btn ghost" href={`${base}/palette/`}>See the palette</a>
        <a class="btn ghost" href={REPO}>GitHub</a>
      </div>
      <div class="cmdline">
        <span class="sigil">❯</span>
        <span class="text">{quick}</span>
        <button class="copy" type="button" data-copy={quick} data-swap="off" aria-label="Copy the install command">
          copy
        </button>
      </div>
    </div>

    <div class="stage" data-parallax aria-hidden="true">
      <div class="ring"></div>
      <img
        class="mark"
        data-depth="1"
        src={`${base}/img/bigface-avatar.svg`}
        alt=""
        width="112"
        height="112"
      />
      <div class="float-window" data-depth="0.4">
        <SyntaxPreview terminal />
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {marquee.map((name) => <span>{name}</span>)}
      {marquee.map((name) => <span>{name}</span>)}
    </div>
  </div>

  <section class="strip-wrap" data-reveal>
    <div class="strip" aria-label="Palette">
      {strip.map((n) => (
        <button
          type="button"
          class="swatch"
          style={`--c:${hex(n)};--ink:${inkOn(hex(n)).ink}`}
          data-copy={hex(n)}
          data-swap="off"
          aria-label={`Copy ${n} ${hex(n)}`}
        >
          <span class="name">{n}</span>
          <span class="hex">{hex(n)}</span>
        </button>
      ))}
    </div>
    <p class="dim caption">
      {colourCount} colours in the palette. This page runs on the theme's own background
      <code>{hex("bg")}</code> — every colour here comes from
      <code>palette/bigface.json</code>. Click a swatch to copy its hex.
    </p>
  </section>

  <section class="stats" data-reveal>
    <div><strong>{targets.length}</strong><span>ports, one source</span></div>
    <div><strong>{colourCount}</strong><span>colours, no variants</span></div>
    <div><strong>0</strong><span>per-tool adjustments</span></div>
    <div><strong>2018</strong><span>first JetBrains release</span></div>
  </section>

  <hr class="hr-grad" />

  <section id="install" class="install">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">01 — install</p>
      <h2>One command, then it asks.</h2>
      <p class="lead">
        The installer shows every app marked <code>installed</code> or <code>detected</code> and lets
        you pick. It writes Bigface's own files only, never edits your config, and prints the one line
        you still need to add.
      </p>
    </div>

    <div class="card glow terminal-card" data-reveal>
      <div class="tabs" data-tabs role="tablist" aria-label="Install options">
        <button type="button" role="tab" data-tab aria-selected="true" aria-controls="tab-interactive">
          Interactive
        </button>
        <button type="button" role="tab" data-tab aria-selected="false" aria-controls="tab-one">
          One app
        </button>
        <button type="button" role="tab" data-tab aria-selected="false" aria-controls="tab-all">
          Everything
        </button>
        <button type="button" role="tab" data-tab aria-selected="false" aria-controls="tab-off">
          Uninstall
        </button>
      </div>

      <div id="tab-interactive" class="panel" role="tabpanel">
        <div class="bar"><i /><i /><i /><span>sh — install</span></div>
        <pre class="cmd"><code>{quick}</code></pre>
        <div class="panel-foot">
          <span class="dim">Asks install or uninstall, then which apps. Enter picks every detected app.</span>
          <button class="copy" type="button" data-copy={quick} data-swap="off">copy</button>
        </div>
      </div>

      <div id="tab-one" class="panel" role="tabpanel" hidden>
        <div class="bar"><i /><i /><i /><span>sh — install ghostty zed vim</span></div>
        <pre class="cmd"><code>{oneApp}</code></pre>
        <div class="panel-foot">
          <span class="dim">Pass any app ids; unknown ones are reported and skipped.</span>
          <button class="copy" type="button" data-copy={oneApp} data-swap="off">copy</button>
        </div>
      </div>

      <div id="tab-all" class="panel" role="tabpanel" hidden>
        <div class="bar"><i /><i /><i /><span>sh — install all</span></div>
        <pre class="cmd"><code>{everything}</code></pre>
        <div class="panel-foot">
          <span class="dim">Every supported app it finds on this machine.</span>
          <button class="copy" type="button" data-copy={everything} data-swap="off">copy</button>
        </div>
      </div>

      <div id="tab-off" class="panel" role="tabpanel" hidden>
        <div class="bar"><i /><i /><i /><span>sh — uninstall all</span></div>
        <pre class="cmd"><code>{removeAll}</code></pre>
        <div class="panel-foot">
          <span class="dim">Removes Bigface's files and prints the lines to drop from your config.</span>
          <button class="copy" type="button" data-copy={removeAll} data-swap="off">copy</button>
        </div>
      </div>
    </div>

    <p class="dim" data-reveal>
      Add <code>--dry-run</code> to see what it would do, or <a href={`${base}/install.sh`}>read the
      script</a> first — it is generated from
      <a href={`${REPO}/blob/main/src/installer.ts`}>src/installer.ts</a>.
    </p>
  </section>

  <hr class="hr-grad" />

  <section id="apps">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">02 — apps</p>
      <h2>{targets.length} ports, one source of truth.</h2>
      <p class="lead">
        Each page says exactly how far its theme was checked — loaded by the tool, validated against
        its schema, or format-checked only. Nothing is claimed stronger than the proof.
      </p>
    </div>

    <div class="filters" data-filter role="group" aria-label="Filter apps">
      <button type="button" data-kind="all" aria-pressed="true">All</button>
      {kinds.map((kind) => (
        <button type="button" data-kind={kind} aria-pressed="false">{kind}</button>
      ))}
    </div>

    <div class="cards" data-cards>
      {targets.map((t, i) => (
        <a
          class="app-card card spotlight"
          data-card-kind={t.kind}
          data-reveal
          href={`${base}/apps/${t.id}/`}
        >
          <span class="idx">{String(i + 1).padStart(2, "0")}</span>
          <span class="app-name">{t.name}</span>
          <span class="app-tag muted" set:html={inline(t.tagline)} />
          <span class="app-foot">
            <span class="pill">{t.kind}</span>
            <span class="foot-right">
              <span
                class={`dot ${t.check.level}`}
                role="img"
                aria-label={isLevel(t.check.level) ? levelLabel[t.check.level] : t.check.level}
                title={isLevel(t.check.level) ? levelLabel[t.check.level] : t.check.level}
              />
              <span class="go" aria-hidden="true">→</span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(1.5rem, 5vw, 4rem) 0 2rem;
  }

  .hero h1 {
    font-size: clamp(3.4rem, 8.5vw, 6.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0.6rem 0 0.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 1.1rem;
  }

  .cmdline {
    max-width: 100%;
    border-radius: 999px;
    align-items: center;
    padding-block: 0.6rem;
  }

  .cmdline .text {
    white-space: nowrap;
    line-height: 1.4;
    font-size: 0.72rem;
    color: var(--cream);
  }

  .cmdline .copy {
    flex: none;
  }

  /* stage */
  .stage {
    position: relative;
    min-height: 340px;
    margin-top: 1.25rem;
    padding-top: 2.2rem;
    display: grid;
    place-items: center;
  }

  .ring {
    position: absolute;
    width: min(78%, 340px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      color-mix(in srgb, var(--blue) 0.0%, transparent) 0deg,
      color-mix(in srgb, var(--blue) 55.0%, transparent) 70deg,
      color-mix(in srgb, var(--lime) 35.0%, transparent) 140deg,
      color-mix(in srgb, var(--blue) 0.0%, transparent) 220deg,
      color-mix(in srgb, var(--purple) 40.0%, transparent) 300deg,
      color-mix(in srgb, var(--blue) 0.0%, transparent) 360deg
    );
    filter: blur(26px);
    opacity: 0.75;
    animation: spin 22s linear infinite;
    z-index: 0;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  .mark {
    position: absolute;
    top: 0;
    right: -8px;
    width: clamp(88px, 10vw, 132px);
    height: auto;
    border-radius: 30px;
    rotate: -6deg;
    z-index: 3;
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px color-mix(in srgb, var(--sky) 30.0%, transparent),
      0 30px 70px -22px color-mix(in srgb, var(--blue) 85.0%, transparent);
    transition: rotate 0.6s var(--ease);
  }

  .stage:hover .mark {
    rotate: 0deg;
  }

  .float-window {
    position: relative;
    z-index: 2;
    width: 100%;
    transform: perspective(1400px) rotateY(-7deg) rotateX(3deg);
    transition: transform 0.6s var(--ease);
    filter: drop-shadow(0 40px 60px color-mix(in srgb, var(--bg-deep) 70.0%, transparent));
  }

  .stage:hover .float-window {
    transform: perspective(1400px) rotateY(-2deg) rotateX(0deg);
  }

  /* ---------- marquee ---------- */
  .marquee {
    overflow: hidden;
    margin: 1.5rem 0 0;
    padding: 0.9rem 0;
    border-block: 1px solid var(--line);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .track {
    display: flex;
    gap: 2.2rem;
    width: max-content;
    animation: slide 42s linear infinite;
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 72%, transparent);
  }

  .track span {
    display: inline-flex;
    align-items: center;
    gap: 2.2rem;
    white-space: nowrap;
  }

  .track span::after {
    content: "✦";
    color: var(--blue);
    opacity: 0.5;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- strip ---------- */
  .strip-wrap {
    margin: 2.2rem 0 0;
  }

  .strip {
    display: flex;
    gap: 0.3rem;
    height: 96px;
  }

  .swatch {
    position: relative;
    flex: 1;
    min-width: 0;
    border: 0;
    border-radius: 12px;
    background: var(--c);
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    transition:
      flex-grow 0.5s var(--ease),
      transform 0.35s var(--ease),
      box-shadow 0.3s var(--ease),
      filter 0.3s var(--ease);
    will-change: flex-grow;
    font: inherit;
  }

  .strip:hover .swatch:not(:hover) {
    filter: saturate(0.72) brightness(0.9);
  }

  .swatch:hover {
    flex-grow: 2.6;
    transform: translateY(-4px);
    box-shadow: 0 18px 34px -26px color-mix(in srgb, var(--fg) 60%, transparent);
  }

  .swatch .name,
  .swatch .hex {
    position: absolute;
    left: 0.6rem;
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    opacity: 0;
    transition: opacity 0.3s;
    color: var(--ink);
  }

  .swatch .name {
    bottom: 1.5rem;
    font-weight: 600;
  }

  .swatch .hex {
    bottom: 0.55rem;
  }

  .swatch:hover .name,
  .swatch:hover .hex {
    opacity: 0.92;
  }

  .caption {
    font-size: 0.87rem;
    margin: 0.7rem 0 0;
  }

  /* ---------- stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 2.5rem 0 0;
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
    background: var(--line);
  }

  .stats div {
    background: color-mix(in srgb, var(--bg-deep) 72.0%, transparent);
    padding: 1.2rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stats strong {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    background: linear-gradient(120deg, #fff, var(--blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  /* ---------- sections ---------- */
  .sec-head {
    max-width: 62ch;
    margin-bottom: 1.6rem;
  }

  .sec-head h2 {
    margin: 0.5rem 0 0.7rem;
  }

  /* ---------- terminal card ---------- */
  .terminal-card {
    padding: 0.9rem;
    overflow: hidden;
  }

  .panel {
    margin-top: 0.8rem;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.72rem;
    color: var(--dim);
  }

  .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .bar i:nth-child(1) {
    background: var(--pink);
  }

  .bar i:nth-child(2) {
    background: var(--yellow);
  }

  .bar i:nth-child(3) {
    background: var(--green);
  }

  .bar span {
    margin-left: 0.5rem;
  }

  .panel pre {
    margin: 0;
    background: color-mix(in srgb, var(--bg-deep) 85.0%, transparent);
  }

  .panel-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.3rem 0.1rem;
    font-size: 0.8rem;
  }

  /* ---------- filters + cards ---------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .filters button {
    font: inherit;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(var(--line-rgb), 0.04);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .filters button:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .filters button[aria-pressed="true"] {
    color: var(--ink-on-bright);
    background: var(--blue);
    border-color: var(--blue);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.9rem;
  }

  .cards [hidden] {
    display: none;
  }

  .app-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.3rem;
    padding: 1.1rem 1.15rem 1rem;
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--r);
    transition: transform 0.35s var(--ease), border-color 0.35s, box-shadow 0.35s;
  }

  .app-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--blue) 45.0%, transparent);
    box-shadow: 0 26px 50px -28px color-mix(in srgb, var(--blue) 65.0%, transparent);
    color: var(--fg);
  }

  .idx {
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.68rem;
    color: var(--dim);
  }

  .app-name {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .app-tag {
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .app-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.55rem;
  }

  .foot-right {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot.tool {
    background: var(--green);
    box-shadow: 0 0 8px color-mix(in srgb, var(--green) 70.0%, transparent);
  }

  .dot.schema {
    background: var(--cyan);
    box-shadow: 0 0 8px color-mix(in srgb, var(--cyan) 70.0%, transparent);
  }

  .dot.format {
    background: var(--orange);
    box-shadow: 0 0 8px color-mix(in srgb, var(--burnt) 70.0%, transparent);
  }

  .app-tag code {
    font-size: 0.92em;
  }

  .go {
    color: var(--blue);
    transition: transform 0.3s var(--ease);
  }

  .app-card:hover .go {
    transform: translateX(4px);
  }

  @media (max-width: 1100px) {
    /* Narrow column: let the command wrap at a space (before the pipe), never inside the URL. */
    .cmdline .text {
      white-space: normal;
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .stage {
      min-height: 300px;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .strip {
      height: 72px;
    }

    .swatch .name,
    .swatch .hex {
      display: none;
    }

    .panel-foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
