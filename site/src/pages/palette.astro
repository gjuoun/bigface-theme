---
import ContrastTable from "../components/ContrastTable.astro";
import Swatch from "../components/Swatch.astro";
import SyntaxPreview from "../components/SyntaxPreview.astro";
import { hex, palette } from "../data/palette.ts";
import { REPO } from "../data/targets.ts";
import Base from "../layouts/Base.astro";

// Groups show only what the 2018 scheme actually defines; the blends get their own block below so
// nobody mistakes them for original colours.
const groups: [string, string, string[]][] = [
  [
    "surfaces",
    "Surfaces",
    ["bg", "cursorLine", "braceMatch", "selection", "border", "borderMuted"],
  ],
  ["text", "Text", ["fg", "comment", "fgDim", "caret"]],
  [
    "accents",
    "Accents",
    [
      "blue",
      "lightBlue",
      "paleBlue",
      "cyan",
      "green",
      "lime",
      "yellow",
      "brightYellow",
      "burntOrange",
      "purple",
    ],
  ],
  ["tints", "Search tints", ["searchBg", "searchFg"]],
];
const syntaxRows = Object.entries(palette.syntax);
const ansiRows = Object.entries(palette.ansi);
const colourCount = Object.keys(palette.colors).length;
---

<Base title="Bigface palette" description="Every colour in the Bigface theme, with the original JetBrains source for each one.">
  <section class="pal-hero" data-reveal>
    <p class="eyebrow">the source of truth</p>
    <h1>One palette.<br /><span class="grad">Nothing else.</span></h1>
    <p class="lead">
      Every theme in the repo is generated from <code>palette/bigface.json</code>, and every colour
      in it is <strong>byte-for-byte from the 2018 JetBrains scheme</strong> — each labelled with the
      exact <code>OPTION#FIELD</code> it came from and checked against the original XML by a test.
      Nothing is blended or invented: when a tool needs a surface the scheme never defined, it gets
      one of the scheme's own surfaces (the caret-row background, the matched-brace block, a border
      grey) instead of a new colour.
    </p>
    <div class="counts">
      <span><strong>{Object.keys(palette.colors).length}</strong> colours</span>
      <span><strong>{ansiRows.length}</strong> ANSI</span>
      <span><strong>{syntaxRows.length}</strong> syntax roles</span>
      <span><strong>{colourCount + ansiRows.length}</strong> from the scheme</span>
    </div>
  </section>

  <div class="preview" data-reveal>
    <SyntaxPreview terminal />
  </div>

  <nav class="subnav" aria-label="Palette sections">
    {groups.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}
    <a href="#ansi">Terminal</a>
    <a href="#syntax">Syntax</a>
    <a href="#contrast">Contrast</a>
  </nav>

  {groups.map(([id, title, names]) => (
    <section id={id} class="group" data-reveal>
      <h2>{title} <span class="count">{names.length}</span></h2>
      <div class="swatches">
        {names.map((n) => <Swatch name={n} color={palette.colors[n]!} />)}
      </div>
    </section>
  ))}

  <section id="ansi" class="group" data-reveal>
    <h2>Terminal (ANSI) <span class="count">{ansiRows.length}</span></h2>
    <div class="swatches">
      {ansiRows.map(([n, c]) => <Swatch name={n} color={c} />)}
    </div>
  </section>

  <section id="syntax" class="group" data-reveal>
    <h2>Syntax roles <span class="count">{syntaxRows.length}</span></h2>
    <table class="roles">
      <thead>
        <tr><th>Role</th><th>Colour</th><th>Hex</th></tr>
      </thead>
      <tbody>
        {syntaxRows.map(([role, name]) => (
          <tr>
            <td class="role">{role}</td>
            <td><i style={`background:${hex(name)}`} /> {name}</td>
            <td><code>{hex(name)}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section id="contrast" class="group" data-reveal>
    <h2>Contrast</h2>
    <p class="muted">
      Informational only. The colours are kept as designed, so a few roles (<code>fgDim</code>,
      <code>comment</code>) sit below the WCAG 4.5:1 body-text guideline by intent.
    </p>
    <ContrastTable />
  </section>

  <p class="dim foot" data-reveal>
    Raw file:
    <a href={`${REPO}/blob/main/palette/bigface.json`}>palette/bigface.json</a> ·
    <a href={`${REPO}/blob/main/src/targets.ts`}>generator targets</a> · Click any swatch to copy its
    hex.
  </p>
</Base>

<style>
  .pal-hero {
    padding-top: clamp(0.5rem, 3vw, 2rem);
  }

  .pal-hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 800;
    line-height: 1.02;
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
  }

  .counts span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--muted);
    background: rgba(var(--line-rgb), 0.04);
  }

  .counts strong {
    color: var(--fg);
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
  }

  .preview {
    margin: 2rem 0 0;
    max-width: 640px;
  }

  .subnav {
    position: sticky;
    top: 3.9rem;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 2.2rem 0 0;
    padding: 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-deep) 82.0%, transparent);
    backdrop-filter: blur(14px);
    font-size: 0.8rem;
  }

  .subnav a {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    color: var(--muted);
  }

  .subnav a:hover {
    color: var(--fg);
    background: rgba(var(--line-rgb), 0.1);
  }

  .group {
    margin-top: 2.8rem;
  }

  .group h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    margin-bottom: 1rem;
  }

  .count {
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.7rem;
    color: var(--dim);
    letter-spacing: 0.08em;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.7rem;
  }

  .derived {
    color: var(--orange);
  }

  .roles {
    max-width: 640px;
  }

  .roles .role {
    font-family: var(--font-mono);
    font-variation-settings: "MONO" 1, "CASL" 0, "CRSV" 0.5;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .roles i {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border-radius: 3px;
    vertical-align: -0.06em;
    margin-right: 0.3rem;
  }

  .foot {
    margin-top: 3rem;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .subnav {
      position: static;
      border-radius: 16px;
    }
  }
</style>
